# Databricks SQL warehouse connection. Use the workspace hostname and HTTP path,
# not the browser URL or warehouse ID.
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=
# Use either a rotated service-principal OAuth secret pair or a short-lived PAT.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_TOKEN=

# Use the instance_url returned by Salesforce OAuth, not the Lightning page URL.
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=